{
  "name": "grove",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "setup": "bun scripts/setup.ts",
    "dev:web": "bun --filter @grove/web dev",
    "dev:server": "bun --filter @grove/server dev",
    "typecheck": "bun scripts/typecheck.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test ./packages ./apps ./scripts",
    "e2e": "playwright test",
    "check": "bun scripts/check.ts",
    "audit": "bun scripts/audit.ts",
    "build:desktop": "bun scripts/build-desktop.ts",
    "smoke:sidecar": "bun scripts/smoke-sidecar.ts",
    "smoke:bundle": "bun scripts/smoke-bundle.ts",
    "guard:tokens": "bun scripts/contrast.ts",
    "dist:macos": "bun scripts/package-macos.ts",
    "smoke:server": "bun scripts/smoke-server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "bun-types": "1.3.14",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.0"
  }
}
