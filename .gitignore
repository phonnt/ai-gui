# Build outputs (sidecar binary + native addons). `src-tauri/binaries` is a
# real dir resolved by Tauri `externalBin` ("binaries/grove-server"); keep its
# .gitkeep so the dir survives a clean checkout.
apps/desktop/src-tauri/binaries/*
!apps/desktop/src-tauri/binaries/.gitkeep
